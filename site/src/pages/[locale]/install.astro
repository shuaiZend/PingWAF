---
import type { GetStaticPaths } from "astro";
import InstallPage from "../../components/install/InstallPage.astro";
import { PREFIXED_LOCALES, type Locale } from "../../i18n/config";

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
---
<InstallPage locale={locale} />
