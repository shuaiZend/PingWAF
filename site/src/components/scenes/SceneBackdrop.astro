---
/**
 * Shared backdrop for every console scene: a faint 32px grid and a warm radial
 * glow anchored top-right. `prefix` namespaces the SVG ids because a page can
 * render several scenes at once and ids are document-global.
 */
interface Props {
  prefix: string;
}

const { prefix } = Astro.props;
const gridId = `sc-${prefix}-grid`;
const glowId = `sc-${prefix}-glow`;
---
<defs>
  <pattern id={gridId} width="32" height="32" patternUnits="userSpaceOnUse">
    <path class="sc-grid-line" d="M32 0H0V32" fill="none" />
  </pattern>
  <radialGradient id={glowId} cx="50%" cy="0%" r="72%">
    <stop class="sc-glow-1" offset="0%" />
    <stop class="sc-glow-2" offset="58%" />
    <stop class="sc-glow-3" offset="100%" />
  </radialGradient>
</defs>
<rect class="sc-grid" width="640" height="400" fill={`url(#${gridId})`} />
<ellipse class="sc-glow" cx="520" cy="-40" rx="300" ry="220" fill={`url(#${glowId})`} />
