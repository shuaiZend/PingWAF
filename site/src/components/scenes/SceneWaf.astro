---
/**
 * WAF engine scene — one request flows through the four detection phases and
 * leaves as a verdict. Rules live in `global.css` under "Console scenes".
 */
import SceneBackdrop from "./SceneBackdrop.astro";
---
<SceneBackdrop prefix="waf" />

<!-- Request -->
<g>
  <rect class="sc-card" x="16" y="20" width="608" height="64" rx="10" />
  <text class="sc-label" x="32" y="42">REQUEST</text>
  <text class="sc-sub" x="608" y="42" text-anchor="end">TLS 1.3 · :443</text>
  <text class="sc-mono" x="32" y="66">GET /search?q=</text>
  <text class="sc-mono sc-waf-payload" x="140" y="66">1%27+OR+1%3D1</text>
  <text class="sc-sub" x="608" y="66" text-anchor="end">200.1.9.4</text>
</g>

<!-- Four detection phases -->
<g>
  <rect class="sc-card sc-waf-stage" x="16" y="96" width="140" height="88" rx="10" />
  <rect class="sc-card sc-waf-stage" x="172" y="96" width="140" height="88" rx="10" />
  <rect class="sc-card sc-waf-stage" x="328" y="96" width="140" height="88" rx="10" />
  <rect class="sc-card sc-waf-stage" x="484" y="96" width="140" height="88" rx="10" />

  <text class="sc-step" x="32" y="124">01</text>
  <text class="sc-stage-name" x="32" y="148">NORMALIZE</text>
  <text class="sc-sub" x="32" y="168">URL · headers · body</text>

  <text class="sc-step" x="188" y="124">02</text>
  <text class="sc-stage-name" x="188" y="148">SIGNATURES</text>
  <text class="sc-sub" x="188" y="168">libinjection · AC</text>

  <text class="sc-step" x="344" y="124">03</text>
  <text class="sc-stage-name" x="344" y="148">EXPRESSION</text>
  <text class="sc-sub" x="344" y="168">rule DSL</text>

  <text class="sc-step" x="500" y="124">04</text>
  <text class="sc-stage-name" x="500" y="148">SCORE</text>
  <text class="sc-sub" x="500" y="168">anomaly total</text>

  <line class="sc-link sc-waf-link" x1="156" x2="172" y1="140" y2="140" />
  <line class="sc-link sc-waf-link" x1="312" x2="328" y1="140" y2="140" />
  <line class="sc-link sc-waf-link" x1="468" x2="484" y1="140" y2="140" />
</g>

<!-- Verdict -->
<g>
  <rect class="sc-card" x="16" y="204" width="300" height="96" rx="10" />
  <text class="sc-label" x="32" y="226">VERDICT</text>
  <text class="sc-verdict" x="32" y="262">BLOCK</text>
  <text class="sc-sub" x="32" y="284">anomaly 84 · SQLi heuristic</text>
  <circle class="sc-dot sc-dot--danger" cx="292" cy="220" r="3.5" />
</g>

<!-- Expression that matched -->
<g>
  <rect class="sc-card" x="328" y="204" width="296" height="96" rx="10" />
  <text class="sc-label" x="344" y="226">MATCHED EXPRESSION</text>
  <text class="sc-code" x="344" y="252">http.request.uri.query</text>
  <text class="sc-code sc-code--accent" x="344" y="272">contains "--"</text>
  <text class="sc-sub" x="344" y="290">action: block · log: on</text>
</g>

<!-- Pipeline legend -->
<g>
  <rect class="sc-card" x="16" y="312" width="608" height="64" rx="10" />
  <text class="sc-label" x="32" y="336">PIPELINE</text>
  <g class="sc-badge sc-badge--plain" transform="translate(32 346)">
    <rect width="86" height="18" rx="4" />
    <text x="43" y="12.5" text-anchor="middle">normalize</text>
  </g>
  <g class="sc-badge sc-badge--plain" transform="translate(126 346)">
    <rect width="94" height="18" rx="4" />
    <text x="47" y="12.5" text-anchor="middle">libinjection</text>
  </g>
  <g class="sc-badge sc-badge--plain" transform="translate(228 346)">
    <rect width="96" height="18" rx="4" />
    <text x="48" y="12.5" text-anchor="middle">Aho-Corasick</text>
  </g>
  <g class="sc-badge sc-badge--brand" transform="translate(332 346)">
    <rect width="96" height="18" rx="4" />
    <text x="48" y="12.5" text-anchor="middle">anomaly score</text>
  </g>
  <text class="sc-sub" x="608" y="358" text-anchor="end">4 phases → 1 verdict</text>
</g>

<rect class="sc-scan" x="-200" y="0" width="200" height="400" fill="url(#sc-waf-scan)" />
<defs>
  <linearGradient id="sc-waf-scan" x1="0" y1="0" x2="1" y2="0">
    <stop class="sc-scan-1" offset="0%" />
    <stop class="sc-scan-2" offset="50%" />
    <stop class="sc-scan-3" offset="100%" />
  </linearGradient>
</defs>
