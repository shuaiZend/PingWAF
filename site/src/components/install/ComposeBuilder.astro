---
import Icon from "../Icon.astro";
import CodeBlock from "../CodeBlock.astro";
import ScreenshotFrame from "../ScreenshotFrame.astro";
import type { InstallContent } from "../../content/schema";
import type { Locale } from "../../i18n/config";

interface Props {
  compose: InstallContent["deployment"]["compose"];
  locale: Locale;
  /** Copy button labels, reused from the script builder content. */
  copyLabel: string;
  copiedLabel: string;
}

const { compose, locale, copyLabel, copiedLabel } = Astro.props;

// Same shape as the client-side builder: the server-rendered command matches
// the defaults, so there is no flash before the script runs.
const composeDefaults = Object.fromEntries(
  compose.fields.map((field) => [field.key, field.defaultValue]),
);
const composeDefaultsJson = JSON.stringify(composeDefaults);
---
<div
  class="compose"
  data-compose-builder
  data-compose-defaults={composeDefaultsJson}
  data-installer-url={compose.installerUrl}
>
  <p class="compose__eyebrow">{compose.tabLabel}</p>
  <h3 class="compose__title">{compose.title}</h3>
  <p class="compose__lead">{compose.lead}</p>

  <ul class="compose__reqs">
    {
      compose.requirements.map((item) => (
        <li>
          <Icon name="check" size={13} />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="compose__panel compose__panel--hero">
    <div class="compose__panel-head">
      <span>{compose.oneLinerTitle}</span>
      <button type="button" class="compose__copy" data-copy="compose-oneliner">
        <Icon name="copy" />
        <span data-copy-label data-copied={copiedLabel}>{copyLabel}</span>
      </button>
    </div>
    <pre class="compose__code mono" id="compose-oneliner" data-oneliner>{compose.oneLiner}</pre>
    <p class="compose__note">{compose.oneLinerNote}</p>
  </div>

  <ol class="compose__steps">
    {
      compose.steps.map((step, index) => (
        <li class="compose__step">
          <span class="compose__step-num">{index + 1}</span>
          <div>
            <h4 class="compose__step-title">{step.title}</h4>
            <p class="compose__step-body">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="compose__customize">
    <h4 class="compose__upgrade-title">{compose.customizeTitle}</h4>
    <p class="compose__upgrade-body">{compose.customizeHint}</p>
    <div class="compose__fields">
      {
        compose.fields.map((field) => (
          <label class="compose__field">
            <span class="compose__field-label">{field.label}</span>
            <input
              type="text"
              data-field={field.key}
              value={field.defaultValue}
              placeholder={field.placeholder}
              autocomplete="off"
              spellcheck="false"
            />
            <span class="compose__field-hint">{field.hint}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div class="compose__panel">
    <div class="compose__panel-head">
      <span>{compose.commandTitle}</span>
      <button type="button" class="compose__copy" data-copy="compose-command">
        <Icon name="copy" />
        <span data-copy-label data-copied={copiedLabel}>{copyLabel}</span>
      </button>
    </div>
    <pre class="compose__code mono" id="compose-command" data-command>{compose.oneLiner}</pre>
    <p class="compose__note">{compose.note}</p>
  </div>

  <div class="compose__upgrade">
    <h4 class="compose__upgrade-title">{compose.upgradeTitle}</h4>
    <p class="compose__upgrade-body">{compose.upgradeBody}</p>
    <CodeBlock locale={locale} lang="bash" filename="bash" code={compose.upgradeCommand} />
  </div>

  {
    compose.screenshot && (
      <ScreenshotFrame
        shot={{ ...compose.screenshot, url: "docker compose up -d" }}
        chrome={false}
        sizes="(max-width: 1080px) 92vw, 720px"
      />
    )
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-compose-builder]");
  if (root) {
    const commandEl = root.querySelector<HTMLElement>("[data-command]");
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-field]"));
    const installerUrl = root.dataset.installerUrl ?? "";
    let defaults: Record<string, string> = {};
    try {
      defaults = JSON.parse(root.getAttribute("data-compose-defaults") ?? "{}") as Record<
        string,
        string
      >;
    } catch {
      defaults = {};
    }

    /** Single-quote for bash only when the shell could interpret the value. */
    const SAFE = /^[A-Za-z0-9%_@.:/=+~-]+$/;
    const shellQuote = (raw: string) => {
      const value = raw.replace(/[\r\n]+/g, " ").trim();
      if (!value) return "";
      if (SAFE.test(value)) return value;
      return `'${value.replace(/'/g, "'\\''")}'`;
    };

    const FLAGS: Array<[string, string]> = [
      ["tag", "--tag"],
      ["adminEmail", "--admin-email"],
      ["tlsSans", "--tls-sans"],
      ["httpPort", "--http-port"],
      ["httpsPort", "--https-port"],
      ["adminPort", "--admin-port"],
    ];

    const build = () => {
      if (!commandEl) return;
      const values: Record<string, string> = {};
      inputs.forEach((input) => {
        values[input.dataset.field ?? ""] = input.value;
      });
      const args = FLAGS.flatMap(([key, flag]) => {
        const raw = values[key] ?? "";
        if (!raw.trim()) return [];
        if (raw.trim() === (defaults[key] ?? "").trim()) return [];
        return [[flag, shellQuote(raw)].join(" ")];
      });
      const base = `curl -fsSL ${installerUrl} | bash`;
      commandEl.textContent = args.length
        ? `${base} -s -- ${args.join(" ")}`
        : base;
    };

    inputs.forEach((input) => input.addEventListener("input", build));
    build();
  }
</script>

<style>
  .compose {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .compose__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
  }

  .compose__title {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    color: var(--color-text-strong);
  }

  .compose__lead {
    margin: 0;
    font-size: var(--site-text-sm);
    line-height: 1.65;
    color: var(--color-text-subtle);
    max-width: 70ch;
  }

  .compose__reqs {
    margin: 0;
    padding: 16px 18px;
    list-style: none;
    display: grid;
    gap: 9px;
    border: 1px solid var(--color-border-line);
    border-radius: var(--radius-lg);
    background: var(--site-surface-inset);
  }

  .compose__reqs li {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-strong);
  }

  .compose__reqs :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--color-bg-brand);
  }

  .compose__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .compose__step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .compose__step-num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--site-brand-soft);
    color: var(--color-text-strong);
    font-size: 11.5px;
    font-weight: 700;
  }

  .compose__step-title {
    margin: 0 0 3px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .compose__step-body {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-subtle);
    max-width: 70ch;
  }

  .compose__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .compose__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .compose__field-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .compose__field input {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid var(--color-border-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-base);
    color: var(--color-text-strong);
    font-family: var(--site-font-mono);
    font-size: 13px;
  }

  .compose__field input:focus {
    outline: none;
    border-color: var(--color-bg-brand);
  }

  .compose__field-hint {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-text-subtle);
  }

  .compose__panel {
    border: 1px solid var(--color-border-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #1d1d1d;
    color: #e8e8e8;
  }

  .compose__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    background: #262626;
    border-bottom: 1px solid #303030;
    font-size: 12.5px;
    color: #9a9a9a;
  }

  .compose__copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid #3a3a3a;
    border-radius: var(--radius-sm);
    background: #1d1d1d;
    color: #cfcfcf;
    font-size: 12px;
    cursor: pointer;
  }

  .compose__copy:hover {
    color: #ffffff;
    border-color: #4a4a4a;
  }

  .compose__code {
    margin: 0;
    padding: 16px 18px;
    font-family: var(--site-font-mono);
    font-size: 13px;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .compose__note {
    margin: 0;
    padding: 12px 18px 14px;
    border-top: 1px solid #303030;
    color: #9a9a9a;
    font-size: 12px;
    line-height: 1.6;
  }

  .compose__upgrade-title {
    margin: 0 0 6px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .compose__upgrade-body {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-text-subtle);
    max-width: 70ch;
  }

  @media (max-width: 1080px) {
    .compose__fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .compose__panel--hero {
    border-color: var(--color-bg-brand);
    box-shadow: 0 0 0 1px var(--color-bg-brand) inset;
  }

  .compose__customize {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
    border-top: 1px dashed var(--color-border-line);
  }
</style>
